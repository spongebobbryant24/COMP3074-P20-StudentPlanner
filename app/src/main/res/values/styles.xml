<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/blue</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/page_bg</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="ScreenTitle">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="ScreenSubtitle">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/muted</item>
    </style>
    <style name="SectionLabel">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="FormLabel">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">7dp</item>
    </style>
</resources>
